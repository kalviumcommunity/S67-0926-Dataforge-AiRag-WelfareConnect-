# ==============================================================================
# WelfareConnect - Environment Variable Configuration
# ==============================================================================
# NOTE: This file contains ONLY placeholder values for development setup.
# Copy this file to .env before starting the application:
#   cp .env.example .env
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Settings
PROJECT_NAME="WelfareConnect Government Scheme Assistant"
ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="sqlite:///./welfareconnect.db"

# Authentication & Security
# WARNING: Generate a secure 256-bit secret key in production
JWT_SECRET="placeholder-jwt-secret-key-must-be-changed-in-production-32-chars-min"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_IN_MINUTES=1440

# Vector Database (Pinecone Integration)
PINECONE_API_KEY="placeholder-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="welfareconnect-schemes-index"
PINECONE_DIMENSION=1536
PINECONE_METRIC="cosine"

# AI & LLM Provider (Deferred for pipeline implementation)
OPENAI_API_KEY="placeholder-openai-api-key"
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_COMPLETION_MODEL="gpt-4o-mini"

# Background Job Queue (Redis)
REDIS_URL="redis://localhost:6379/0"

# Storage Configuration (local | s3 | minio)
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./data/storage"
S3_BUCKET_NAME="placeholder-welfareconnect-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="placeholder-s3-key"
S3_SECRET_ACCESS_KEY="placeholder-s3-secret"

# Frontend Configuration (Next.js Public Variables)
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="WelfareConnect"
NEXT_PUBLIC_ENABLE_CITATIONS_DRAWER="true"
