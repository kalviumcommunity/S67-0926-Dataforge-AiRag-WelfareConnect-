# ==============================================================================
# Government Welfare Scheme Document Assistant - Environment Configuration
# NOTE: This is an example template. DO NOT put real secrets in this file.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=WelfareSchemeDocumentAssistant
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres_user:placeholder_password@localhost:5432/welfare_rag_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Object Storage Configuration (S3 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=welfare-documents-bucket
STORAGE_ACCESS_KEY=placeholder_access_key
STORAGE_SECRET_KEY=placeholder_secret_key
STORAGE_USE_SSL=false

# Task Queue Broker (Redis / RabbitMQ)
REDIS_URL=redis://localhost:6379/0

# AI / Model Gateway Configuration (Placeholders for future pipeline)
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=placeholder_api_key

# Security & Session Authentication
JWT_SECRET=placeholder_jwt_secret_must_be_at_least_32_chars_long
JWT_EXPIRES_IN=24h

# Grounding & Guardrail Thresholds
SIMILARITY_THRESHOLD=0.65
MAX_RETRIEVED_CHUNKS=5
STRICT_CITATION_ENFORCEMENT=true
