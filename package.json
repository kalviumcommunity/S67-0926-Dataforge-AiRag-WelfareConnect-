{
  "name": "welfare-scheme-document-assistant",
  "version": "1.0.0",
  "description": "Government Welfare Scheme Document Assistant - Retrieval Augmented Intelligence with Exact Page Citations",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx backend/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:migrate": "tsx backend/src/db/migrator.ts",
    "db:seed": "tsx backend/src/db/seed.ts"
  },
  "keywords": [
    "welfare-schemes",
    "rag",
    "government-ai",
    "document-assistant",
    "grounded-search",
    "citations",
    "postgresql",
    "pgvector"
  ],
  "author": "Government Digital Service Architecture Team",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
